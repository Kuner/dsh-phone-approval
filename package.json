{
  "name": "dsh-phone-approval",
  "version": "1.3.3",
  "private": true,
  "description": "DeepSeek Harness plugin: Bark notifications for approvals, questions, finished turns and errors, plus Face ID phone approval over Tailscale.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "admin.js",
    "phone-approval.js",
    "webauthn.js",
    "bark-crypto.js",
    "page.js",
    "tailscale.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node --check index.js && node --check admin.js && node --check phone-approval.js && node --check webauthn.js && node --check bark-crypto.js && node --check page.js && node --check tailscale.js && node --check client.js",
    "test": "node test/e2e.mjs && node test/client-smoke.mjs",
    "screenshots": "tools/screenshots/capture.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
